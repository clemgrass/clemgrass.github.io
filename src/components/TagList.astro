---
interface Props {
  engine: string;
  tech: string[];
}

const { engine, tech } = Astro.props;
const all = [engine, ...tech.filter((t) => t !== engine)];
---
<ul class="tags">
  {all.map((t) => <li class="tag">{t}</li>)}
</ul>

<style>
  .tags {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tag {
    font-size: 0.72rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1rem var(--space-2);
  }
</style>
